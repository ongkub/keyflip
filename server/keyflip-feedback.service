[Unit]
Description=KeyFlip problem report receiver
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=keyflip-feedback
EnvironmentFile=/etc/keyflip-feedback.env
WorkingDirectory=/opt/keyflip-feedback
ExecStart=/usr/bin/python3 /opt/keyflip-feedback/feedback_server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
